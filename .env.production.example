# Copie para .env.production e preencha valores reais.
# NÃO commite o arquivo .env.production.
#
# Gerar senhas:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

PROJECT_NAME=SaldoContratual
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=troque-esta-chave-com-pelo-menos-32-bytes
FRONTEND_HOST=http://SEU_IP_PUBLICO:8080
HTTP_PORT=8080

ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-admin
ADMIN_NOME=Administrador

# Cabeçalho impresso no Relatório de Saldo de Contrato.
# Sem ORGAO_NOME o relatório usa PROJECT_NAME.
ORGAO_NOME=Prefeitura Municipal de Exemplo
ORGAO_ESTADO=Estado da Bahia
ORGAO_SETOR=Setor de Licitações
